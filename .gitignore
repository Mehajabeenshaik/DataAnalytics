__pycache__/
*.pyc

# ── Secrets & env files ──────────────────────────────────────────────
# .env contains real API keys — NEVER commit it.
# .env.example is safe (placeholders only) and SHOULD be committed.
.env
.env.local
.env.*.local

# ── Databases ───────────────────────────────────────────────────────
# Plaintext DBs are gitignored (contain real data).
*.db
*.db.key

# Encrypted DBs (*.db.enc) are generated at runtime — do NOT ship them
# in the repo. Users generate their own demo/PII data.
*.db.enc

# ── Evaluation output logs ─────────────────────────────────────────
# Eval result logs are historical artifacts — regenerate, don't commit.
eval/results*.txt

# ── Runtime metric catalog data ────────────────────────────────────
# data/catalog/ is generated at runtime (seeded metrics, proposals,
# version history). Regenerate it — don't commit runtime state.
data/catalog/

# ── Runtime tenant / quota / observability data ────────────────────
# Generated at runtime (Phase 2 + Phase 3). Regenerate — don't commit.
data/tenants/
data/quotas/
data/observability/
data/tenants_data/
