# 🎯 DataAnalytics Environment Configuration 🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# The .env file is gitignored and will NEVER be committed.
# config.py automatically loads .env on startup via python-dotenv.

# 🎯 LLM Provider 🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯
# "ollama" (default, local), "gemini" (Google Cloud), "nvidia" (NVIDIA NIM),
# or "vllm" (self-hosted vLLM server)
LLM_PROVIDER=ollama

# Google Gemini API key 🎯 only needed if LLM_PROVIDER=gemini
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Ollama settings 🎯 only needed if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-3-nano:4b

# NVIDIA NIM settings 🎯 only needed if LLM_PROVIDER=nvidia
# Get an API key at https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-super-49b-v1

# Self-hosted vLLM settings 🎯 only needed if LLM_PROVIDER=vllm
# Start your own OpenAI-compatible server with:
#   vllm serve meta-llama/Llama-3.1-8B-Instruct --port 8000
# No API key needed unless your server is behind an auth-gated proxy.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_API_KEY=

# 🎯 Security 🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯
# REQUIRED: strong random secret for JWT signing.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-here

# DB encryption key (Fernet). Leave empty to auto-generate on first run.
# To create one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=

# 🎯 Database Paths 🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯
# Defaults are relative to the project root; override only if needed.
DB_PATH=ecommerce.db
PII_VAULT_PATH=pii_vault.db
PII_VAULT_ENCRYPTED_PATH=pii_vault.db.enc
AUTH_DB_PATH=auth.db
AUDIT_DB_PATH=audit.db

# 🎯 Session & Cache 🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯
JWT_EXPIRE_MINUTES=30
SESSION_TIMEOUT_MINUTES=30
CACHE_TTL_SECONDS=300

# 🎯 Phase 2: Tenant quotas & resource limits 🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯
DEFAULT_MAX_QUERIES_PER_DAY=500
DEFAULT_MAX_LLM_CALLS_PER_DAY=1000
DEFAULT_MAX_ROWS_PER_QUERY=100000
DEFAULT_MAX_FILE_SIZE_MB=50
DEFAULT_MAX_PLAN_STEPS=3
DEFAULT_QUERY_TIMEOUT_SECONDS=30

# 🎯 Phase 3: Tenant isolation & SSO 🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯🎯
# TENANT_ISOLATION_ENABLED=true forces every request to carry a valid
# tenant context. DEFAULT_TENANT_ID is ONLY for local demo; production
# must not rely on it.
TENANT_ISOLATION_ENABLED=true
DEFAULT_TENANT_ID=default

# OIDC / SSO (WorkOS / Auth0 / Descope / Keycloak style)
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

SSO_ENABLED=true
SSO_PROVIDER=local
APP_BASE_URL=http://localhost:8000

# ── Tenant store backend ──────────────────────────────────────────────────
# file   → YAML files under data/tenants/ (default, zero dependencies)
# postgres → PostgreSQL (requires psycopg2-binary and a running Postgres instance)
TENANT_STORE=file

# Required when TENANT_STORE=postgres.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Local dev (matches docker-compose.yml):
# TENANT_DATABASE_URL=postgresql://analytics:analytics@localhost:5432/tenantdb
TENANT_DATABASE_URL=